{
  "$schema": "https://tr.designtokens.org/format/",
  "fontFamily": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "SF Pro",
        "-apple-system",
        "BlinkMacSystemFont",
        "Geist",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "SF Mono",
        "ui-monospace",
        "Geist Mono",
        "monospace"
      ]
    },
    "serif": {
      "$type": "fontFamily",
      "$value": [
        "New York",
        "ui-serif",
        "Georgia",
        "serif"
      ]
    }
  },
  "fontWeight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "medium": {
      "$type": "fontWeight",
      "$value": 500
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600
    }
  },
  "typeStyle": {
    "micro": {
      "$type": "typography",
      "$value": {
        "fontFamily": "mono",
        "fontSize": "9px",
        "fontWeight": 500,
        "letterSpacing": "0.6px",
        "lineHeight": 1.2,
        "tabularNums": true,
        "textTransform": "uppercase"
      }
    },
    "eyebrow": {
      "$type": "typography",
      "$value": {
        "fontFamily": "mono",
        "fontSize": "10px",
        "fontWeight": 500,
        "letterSpacing": "1.1px",
        "lineHeight": 1.3,
        "tabularNums": true,
        "textTransform": "uppercase"
      }
    },
    "monoValue": {
      "$type": "typography",
      "$value": {
        "fontFamily": "mono",
        "fontSize": "11px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": 1.3,
        "tabularNums": true
      }
    },
    "monoSmall": {
      "$type": "typography",
      "$value": {
        "fontFamily": "mono",
        "fontSize": "10px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": 1.3,
        "tabularNums": true
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "sans",
        "fontSize": "11px",
        "fontWeight": 400,
        "letterSpacing": "0.06px",
        "lineHeight": 1.4
      }
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "sans",
        "fontSize": "12px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": 1.4
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "sans",
        "fontSize": "13px",
        "fontWeight": 400,
        "letterSpacing": "-0.08px",
        "lineHeight": 1.45
      }
    },
    "bodyStrong": {
      "$type": "typography",
      "$value": {
        "fontFamily": "sans",
        "fontSize": "13px",
        "fontWeight": 600,
        "letterSpacing": "-0.1px",
        "lineHeight": 1.4
      }
    },
    "prose": {
      "$type": "typography",
      "$value": {
        "fontFamily": "sans",
        "fontSize": "14px",
        "fontWeight": 400,
        "letterSpacing": "-0.15px",
        "lineHeight": 1.55
      }
    },
    "cardTitle": {
      "$type": "typography",
      "$value": {
        "fontFamily": "sans",
        "fontSize": "14px",
        "fontWeight": 600,
        "letterSpacing": "-0.2px",
        "lineHeight": 1.3
      }
    },
    "sectionTitle": {
      "$type": "typography",
      "$value": {
        "fontFamily": "sans",
        "fontSize": "17px",
        "fontWeight": 600,
        "letterSpacing": "-0.35px",
        "lineHeight": 1.25
      }
    },
    "pageTitle": {
      "$type": "typography",
      "$value": {
        "fontFamily": "sans",
        "fontSize": "28px",
        "fontWeight": 600,
        "letterSpacing": "-0.9px",
        "lineHeight": 1.1
      }
    },
    "mediumValue": {
      "$type": "typography",
      "$value": {
        "fontFamily": "sans",
        "fontSize": "22px",
        "fontWeight": 500,
        "letterSpacing": "-0.6px",
        "lineHeight": 1.05,
        "tabularNums": true
      }
    },
    "displayValue": {
      "$type": "typography",
      "$value": {
        "fontFamily": "sans",
        "fontSize": "34px",
        "fontWeight": 500,
        "letterSpacing": "-1.3px",
        "lineHeight": 1.0,
        "tabularNums": true
      }
    },
    "heroTitle": {
      "$type": "typography",
      "$value": {
        "fontFamily": "sans",
        "fontSize": "28px",
        "fontWeight": 600,
        "letterSpacing": "-0.9px",
        "lineHeight": 1.1
      }
    },
    "notchTitle": {
      "$type": "typography",
      "$value": {
        "fontFamily": "sans",
        "fontSize": "13px",
        "fontWeight": 600,
        "letterSpacing": "-0.15px",
        "lineHeight": 1.2
      }
    },
    "notchValue": {
      "$type": "typography",
      "$value": {
        "fontFamily": "sans",
        "fontSize": "22px",
        "fontWeight": 500,
        "letterSpacing": "-0.7px",
        "lineHeight": 1.0,
        "tabularNums": true
      }
    },
    "lyric": {
      "$type": "typography",
      "$value": {
        "fontFamily": "serif",
        "fontSize": "16px",
        "fontWeight": 400,
        "letterSpacing": "-0.1px",
        "lineHeight": 1.45
      }
    }
  }
}