{
  "manifest_version": 3,
  "name": "timbr. Tab Audio Control",
  "version": "1.0.0",
  "description": "Per-tab gain & mute bridge for timbr. on macOS (local loopback IPC only, zero telemetry).",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:48192/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "timbr. Tab Audio"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
